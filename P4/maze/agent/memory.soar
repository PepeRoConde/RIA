##################################################
# MONITORING AND DEBUGGING
#
# Simple monitoring rules for the left-wall following agent.
# Memory tracking is not needed for basic wall-following.
##################################################

##################################################
# PROGRESS MONITORING
##################################################

sp {maze-navigator*monitor*progress
   "Print progress information every step"
   (state <s> ^name maze-navigator
              ^io.input-link <il>
              ^operator <o>
              ^orientation <orient>)
   (<o> ^name move
        ^direction <dir>)
   (<il> ^pos-x <x>
         ^pos-y <y>
         ^manhattan-distance <dist>)
-->
   (write (crlf) |[Step] Position: (| <x> |,| <y> |) |
          |Moving: | <dir> | Facing: | <orient> | Distance: | <dist> )}

##################################################
# DEADLOCK DETECTION
##################################################

sp {maze-navigator*detect*no-moves
   "Detect when no moves are available (fully surrounded by walls)"
   (state <s> ^name maze-navigator
              ^io.input-link <il>)
   (<il> ^sensors <sensors>
         ^at-target no)
   (<sensors> ^up wall
              ^down wall
              ^left wall
              ^right wall)
-->
   (write (crlf) |ERROR: Agent is completely surrounded by walls!| (crlf))
   (halt)}
