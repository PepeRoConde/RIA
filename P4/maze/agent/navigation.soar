##################################################
# LEFT-WALL FOLLOWING NAVIGATION
#
# The agent follows the left wall to navigate the maze.
# Strategy: Always try left first, then straight, then right, then back.
##################################################

##################################################
# ELABORATIONS: Compute relative directions
# Based on current orientation, figure out which absolute direction
# corresponds to left, straight, right, and back.
##################################################

# When facing NORTH (up)
sp {elaborate*relative-directions*facing-north
   "Compute relative directions when facing north"
   (state <s> ^name maze-navigator
              ^orientation north)
-->
   (<s> ^relative <rel>)
   (<rel> ^left-is left
          ^straight-is up
          ^right-is right
          ^back-is down)}

# When facing EAST (right)
sp {elaborate*relative-directions*facing-east
   "Compute relative directions when facing east"
   (state <s> ^name maze-navigator
              ^orientation east)
-->
   (<s> ^relative <rel>)
   (<rel> ^left-is up
          ^straight-is right
          ^right-is down
          ^back-is left)}

# When facing SOUTH (down)
sp {elaborate*relative-directions*facing-south
   "Compute relative directions when facing south"
   (state <s> ^name maze-navigator
              ^orientation south)
-->
   (<s> ^relative <rel>)
   (<rel> ^left-is right
          ^straight-is down
          ^right-is left
          ^back-is up)}

# When facing WEST (left)
sp {elaborate*relative-directions*facing-west
   "Compute relative directions when facing west"
   (state <s> ^name maze-navigator
              ^orientation west)
-->
   (<s> ^relative <rel>)
   (<rel> ^left-is down
          ^straight-is left
          ^right-is up
          ^back-is right)}

##################################################
# OPERATOR PROPOSALS: Propose moves based on sensors
##################################################

# Propose moving up
sp {propose*move*up
   "Propose moving up if not blocked"
   (state <s> ^name maze-navigator
              ^io.input-link <il>)
   (<il> ^sensors <sens>
         ^at-target no)
   (<sens> ^up clear)
-->
   (<s> ^operator <o> +)
   (<o> ^name move
        ^direction up
        ^new-orientation north)}

# Propose moving down
sp {propose*move*down
   "Propose moving down if not blocked"
   (state <s> ^name maze-navigator
              ^io.input-link <il>)
   (<il> ^sensors <sens>
         ^at-target no)
   (<sens> ^down clear)
-->
   (<s> ^operator <o> +)
   (<o> ^name move
        ^direction down
        ^new-orientation south)}

# Propose moving left
sp {propose*move*left
   "Propose moving left if not blocked"
   (state <s> ^name maze-navigator
              ^io.input-link <il>)
   (<il> ^sensors <sens>
         ^at-target no)
   (<sens> ^left clear)
-->
   (<s> ^operator <o> +)
   (<o> ^name move
        ^direction left
        ^new-orientation west)}

# Propose moving right
sp {propose*move*right
   "Propose moving right if not blocked"
   (state <s> ^name maze-navigator
              ^io.input-link <il>)
   (<il> ^sensors <sens>
         ^at-target no)
   (<sens> ^right clear)
-->
   (<s> ^operator <o> +)
   (<o> ^name move
        ^direction right
        ^new-orientation east)}

##################################################
# LEFT-WALL FOLLOWING PREFERENCES
# Prefer moves in this order: LEFT > STRAIGHT > RIGHT > BACK
##################################################

# HIGHEST PRIORITY: Prefer turning/moving LEFT
sp {prefer*move*left-relative
   "Prefer moving to the left (relative to current orientation)"
   (state <s> ^name maze-navigator
              ^relative.left-is <left-dir>
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name move
         ^direction <left-dir>)
   (<o2> ^name move
         ^direction <> <left-dir>)
-->
   (<s> ^operator <o1> > <o2>)}

# SECOND PRIORITY: Prefer going STRAIGHT
sp {prefer*move*straight-relative
   "Prefer moving straight (relative to current orientation)"
   (state <s> ^name maze-navigator
              ^relative <rel>
              ^operator <o1> +
              ^operator <o2> +)
   (<rel> ^straight-is <straight-dir>
          ^left-is <left-dir>)
   (<o1> ^name move
         ^direction <straight-dir>)
   (<o2> ^name move
         ^direction <> <straight-dir>
         ^direction <> <left-dir>)
-->
   (<s> ^operator <o1> > <o2>)}

# THIRD PRIORITY: Prefer turning/moving RIGHT
sp {prefer*move*right-relative
   "Prefer moving to the right (relative to current orientation)"
   (state <s> ^name maze-navigator
              ^relative <rel>
              ^operator <o1> +
              ^operator <o2> +)
   (<rel> ^right-is <right-dir>
          ^back-is <back-dir>)
   (<o1> ^name move
         ^direction <right-dir>)
   (<o2> ^name move
         ^direction <back-dir>)
-->
   (<s> ^operator <o1> > <o2>)}

##################################################
# APPLY MOVEMENT
# Execute the movement and update orientation
##################################################

sp {apply*move*execute
   "Execute a move command on the output-link"
   (state <s> ^name maze-navigator
              ^operator <o>
              ^io.output-link <ol>
              ^orientation <old-orient>)
   (<o> ^name move
        ^direction <dir>
        ^new-orientation <new-orient>)
-->
   (<ol> ^move <cmd>)
   (<cmd> ^direction <dir>)
   (write (crlf) |Moving | <dir> | (facing | <old-orient> | -> | <new-orient> |)| )}

sp {apply*move*update-orientation
   "Update agent orientation after successful move"
   (state <s> ^name maze-navigator
              ^operator <o>
              ^orientation <old-orient>)
   (<o> ^name move
        ^new-orientation <new-orient>)
-->
   (<s> ^orientation <old-orient> -
        ^orientation <new-orient>)}

# Remove completed commands
sp {apply*move*remove-command
   "Remove completed move commands from output-link"
   (state <s> ^name maze-navigator
              ^io.output-link <ol>)
   (<ol> ^move <cmd>)
   (<cmd> ^status << complete error >>)
-->
   (<ol> ^move <cmd> -)}
