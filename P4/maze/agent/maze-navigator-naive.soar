##################################################
# Maze Navigator Agent - NAIVE STRATEGY
# 
# A Soar agent that navigates toward the target using
# target-seeking heuristics with memory of visited cells.
##################################################

# Load the navigation rules for naive strategy
source navigation-naive.soar

# Load the memory management rules  
source memory.soar

##################################################
# INITIALIZATION
##################################################

sp {maze-navigator*propose*initialize
   "Propose initialization of the agent state"
   (state <s> ^superstate nil
             -^name)
-->
   (<s> ^operator <o> +)
   (<o> ^name initialize-maze-navigator)}

sp {maze-navigator*apply*initialize
   "Initialize agent state and structures"
   (state <s> ^operator <o>)
   (<o> ^name initialize-maze-navigator)
-->
   (<s> ^name maze-navigator)
   (write (crlf) |Maze Navigator initialized (NAIVE strategy)| (crlf))}

##################################################
# TIE BREAKING - CLOCKWISE PREFERENCE
# Prefer directions in clockwise order: right > down > left > up
##################################################

sp {maze-navigator*prefer*clockwise*right-over-down
   "Prefer right over down when tied"
   (state <s> ^name maze-navigator
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name move ^direction right)
   (<o2> ^name move ^direction down)
-->
   (<s> ^operator <o1> > <o2>)}

sp {maze-navigator*prefer*clockwise*right-over-left
   "Prefer right over left when tied"
   (state <s> ^name maze-navigator
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name move ^direction right)
   (<o2> ^name move ^direction left)
-->
   (<s> ^operator <o1> > <o2>)}

sp {maze-navigator*prefer*clockwise*right-over-up
   "Prefer right over up when tied"
   (state <s> ^name maze-navigator
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name move ^direction right)
   (<o2> ^name move ^direction up)
-->
   (<s> ^operator <o1> > <o2>)}

sp {maze-navigator*prefer*clockwise*down-over-left
   "Prefer down over left when tied"
   (state <s> ^name maze-navigator
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name move ^direction down)
   (<o2> ^name move ^direction left)
-->
   (<s> ^operator <o1> > <o2>)}

sp {maze-navigator*prefer*clockwise*down-over-up
   "Prefer down over up when tied"
   (state <s> ^name maze-navigator
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name move ^direction down)
   (<o2> ^name move ^direction up)
-->
   (<s> ^operator <o1> > <o2>)}

sp {maze-navigator*prefer*clockwise*left-over-up
   "Prefer left over up when tied"
   (state <s> ^name maze-navigator
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name move ^direction left)
   (<o2> ^name move ^direction up)
-->
   (<s> ^operator <o1> > <o2>)}

sp {maze-navigator*prefer*final-indifferent
   "Final fallback: all move operators are indifferent"
   (state <s> ^name maze-navigator
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name move)
   (<o2> ^name move)
-->
   (<s> ^operator <o1> = <o2>)}

##################################################
# SUCCESS DETECTION
##################################################

sp {maze-navigator*detect*success
   "Detect when agent has reached the target"
   (state <s> ^name maze-navigator
              ^io.input-link <il>)
   (<il> ^at-target yes)
-->
   (write (crlf) |SUCCESS! Target reached!| (crlf))
   (halt)}
